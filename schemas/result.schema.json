{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/gw99-wz/Bohrium--15-/schemas/result.schema.json",
  "title": "reading15 result.json",
  "description": "Output contract of the evidence-bound knowledge graph Skill. `case_id` plus every field named by the running case's output_contract must be present; this schema covers the fields the Skill itself guarantees. Validated by scripts/validate_result.py, which does not trust it alone.",
  "type": "object",
  "required": ["case_id", "sources", "graph", "queries", "evidence", "run", "uncertainty", "quality_control"],
  "additionalProperties": true,
  "properties": {
    "case_id": {
      "type": "string",
      "minLength": 1,
      "description": "Echo of the input case identifier, so a reviewer can pair result with input."
    },
    "contract": {
      "type": "object",
      "description": "What the case asked for and whether this result satisfies it.",
      "required": ["source", "required", "found", "missing", "satisfied"],
      "properties": {
        "source": { "type": "string", "description": "case.json:<path> when resolved, 'fallback' otherwise" },
        "required": { "type": "array", "items": { "type": "string" } },
        "found": { "type": "array", "items": { "type": "string" } },
        "missing": { "type": "array", "items": { "type": "string" } },
        "satisfied": { "type": "boolean" }
      }
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["source_id"],
        "properties": {
          "source_id": { "type": "string" },
          "role": { "type": "string" },
          "doi": { "type": "string" },
          "title": { "type": "string" },
          "authors": { "type": "array", "items": { "type": "string" } },
          "licence": { "type": "string" },
          "origin": { "type": "string" },
          "sha256": { "type": "string" },
          "paragraph_count": { "type": "integer" }
        }
      }
    },
    "graph": {
      "type": "object",
      "required": ["nodes", "edges", "stats"],
      "properties": {
        "nodes": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id", "type", "label", "sources", "mentions"],
            "properties": {
              "id": { "type": "string", "pattern": "^node:[0-9a-f]{12}$" },
              "type": {
                "enum": ["researcher", "material", "method", "task", "metric", "conclusion"]
              },
              "label": { "type": "string", "minLength": 2 },
              "aliases": { "type": "array", "items": { "type": "string" } },
              "canonical": { "type": "string" },
              "sources": { "type": "array", "minItems": 1, "items": { "type": "string" } },
              "scope": { "enum": ["single_paper", "cross_paper_concept"] },
              "same_instance_across_papers": { "type": ["boolean", "null"] },
              "mentions": {
                "type": "array",
                "minItems": 1,
                "items": { "$ref": "#/$defs/mention" }
              }
            }
          }
        },
        "edges": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id", "type", "subject", "object", "evidence"],
            "properties": {
              "id": { "type": "string", "pattern": "^edge:[0-9a-f]{12}$" },
              "type": {
                "enum": ["uses", "compares", "outperforms", "supports", "contradicts", "measures", "characterizes"]
              },
              "subject": { "type": "string" },
              "object": { "type": "string" },
              "subject_label": { "type": "string" },
              "object_label": { "type": "string" },
              "direction": { "type": "string" },
              "conditions": { "type": "array", "items": { "type": "string" } },
              "evidence_strength": { "enum": ["direct", "table", "indirect", "inferred"] },
              "basis": { "type": "string" },
              "evidence": {
                "type": "object",
                "required": ["locator", "quote"],
                "properties": {
                  "locator": { "$ref": "#/$defs/locator" },
                  "quote": { "type": "string", "minLength": 8 }
                }
              }
            }
          }
        },
        "issues": { "type": "array", "items": { "type": "object" } },
        "stats": {
          "type": "object",
          "required": ["nodes", "edges"],
          "properties": {
            "nodes": { "type": "integer" },
            "edges": { "type": "integer" },
            "nodes_by_type": { "type": "object" },
            "edges_by_type": { "type": "object" }
          }
        }
      }
    },
    "queries": {
      "type": "array",
      "minItems": 3,
      "description": "At least three queries that were actually executed against this graph.",
      "items": {
        "type": "object",
        "required": ["id", "question", "executed", "answers", "answer_count", "evidence"],
        "properties": {
          "id": { "type": "string" },
          "question": { "type": "string" },
          "kind": { "type": "string" },
          "executed": { "const": true },
          "subgraph": { "type": "object" },
          "answers": { "type": "array" },
          "answer_count": { "type": "integer", "minimum": 0 },
          "undetermined": {
            "type": "array",
            "description": "What the graph cannot settle, and why. A zero-answer query must explain itself here.",
            "items": {
              "type": "object",
              "required": ["question", "status", "reason"],
              "properties": {
                "question": { "type": "string" },
                "status": { "enum": ["undetermined", "refused"] },
                "reason": { "type": "string" },
                "rule": { "type": "string" },
                "what_would_be_needed": { "type": "string" },
                "human_takeover": { "type": "string" }
              }
            }
          },
          "evidence": { "type": "array", "items": { "type": "string" } }
        }
      }
    },
    "evidence": {
      "type": "object",
      "required": ["ledger", "rejected", "counts"],
      "properties": {
        "ledger": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["kind", "id", "label", "locator", "quote"],
            "properties": {
              "kind": { "enum": ["entity", "relation"] },
              "id": { "type": "string" },
              "label": { "type": "string" },
              "locator": { "$ref": "#/$defs/locator" },
              "quote": { "type": "string" }
            }
          }
        },
        "rejected": {
          "type": "array",
          "description": "Spans that failed verification. Kept, not deleted: a rejected quote is a finding.",
          "items": {
            "type": "object",
            "required": ["verification"],
            "properties": {
              "verification": {
                "type": "object",
                "required": ["found", "reason", "detail"],
                "properties": {
                  "found": { "const": false },
                  "reason": { "enum": ["unknown_locator", "quote_not_in_paragraph"] },
                  "detail": { "type": "string" },
                  "paragraph_sha256": { "type": "string" }
                }
              }
            }
          }
        },
        "counts": {
          "type": "object",
          "required": ["ledger", "rejected"],
          "properties": {
            "ledger": { "type": "integer" },
            "rejected": { "type": "integer" },
            "verified_edges": { "type": "integer" }
          }
        }
      }
    },
    "alignment": {
      "type": "object",
      "properties": {
        "merges": { "type": "array", "items": { "type": "object" } },
        "blocked": {
          "type": "array",
          "description": "Every refusal to merge. kind=must_not_merge with level in instance|condition|value.",
          "items": { "type": "object" }
        }
      }
    },
    "run": {
      "type": "object",
      "required": ["status", "mode", "counts"],
      "properties": {
        "status": { "enum": ["success", "partial", "uncertain", "refused"] },
        "mode": { "enum": ["skill", "baseline"] },
        "semantic_layer": { "type": "string" },
        "counts": { "type": "object" },
        "limits": { "type": "array", "items": { "type": "string" } },
        "warnings": { "type": "array", "items": { "type": "object" } },
        "elapsed_seconds": { "type": "number" },
        "generator": { "type": "object" },
        "refused_reason": { "type": "string" }
      }
    },
    "uncertainty": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["kind", "description"],
        "properties": {
          "kind": { "type": "string" },
          "description": { "type": "string" },
          "related": { "type": "string" },
          "human_takeover": { "type": "string" }
        }
      }
    },
    "quality_control": {
      "type": "object",
      "required": ["checks", "critical_failures"],
      "properties": {
        "checks": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["code", "severity", "passed", "detail"],
            "properties": {
              "code": { "type": "string" },
              "severity": { "enum": ["critical", "warn"] },
              "passed": { "type": "boolean" },
              "detail": { "type": "string" }
            }
          }
        },
        "critical_failures": { "type": "integer" },
        "warnings": { "type": "integer" },
        "contract_source": { "type": "string" }
      }
    },
    "change_log": { "type": "array", "items": { "type": "object" } }
  },
  "$defs": {
    "locator": {
      "type": "object",
      "description": "Where the evidence sits. A JATS paragraph id — never a PDF page number.",
      "required": ["source_id", "paragraph_id", "char_start", "char_end", "match_kind"],
      "properties": {
        "source_id": { "type": "string" },
        "paragraph_id": { "type": "string" },
        "section": { "type": "string" },
        "char_start": { "type": ["integer", "null"] },
        "char_end": { "type": ["integer", "null"] },
        "match_kind": { "enum": ["exact", "folded", "squashed", "unverified"] },
        "matched_text": { "type": "string" },
        "paragraph_sha256": { "type": "string" }
      },
      "not": {
        "anyOf": [{ "required": ["page"] }, { "required": ["page_number"] }]
      }
    },
    "mention": {
      "type": "object",
      "required": ["source_id", "paragraph_id", "locator", "quote"],
      "properties": {
        "source_id": { "type": "string" },
        "paragraph_id": { "type": "string" },
        "locator": { "$ref": "#/$defs/locator" },
        "quote": { "type": "string", "minLength": 8 },
        "rule": { "type": "string" },
        "evidence_strength": { "enum": ["direct", "table", "indirect", "inferred"] }
      }
    }
  }
}
