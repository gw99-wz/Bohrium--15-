# Python
__pycache__/
*.py[cod]
*.pyo
.venv/
venv/
.pytest_cache/

# Local run artifacts — never committed
/work/
/out/
/output/
/tmp/
.testwork/

# Logs are scratch, except the ones kept as evidence
*.log
!evidence/**/*.log

# Downloaded third-party paper bundles (licence + size): re-fetched, not vendored.
# Reproduce them with: python scripts/fetch_corpus.py --out corpus/ws2-pair
/corpus/
/data/raw/

# Curated evidence (evidence/) and the example output (examples/minimal/output/) ARE
# committed: they are small and a reviewer should be able to check them without a rerun.

# OS / editor
Thumbs.db
.DS_Store
.idea/
.vscode/
